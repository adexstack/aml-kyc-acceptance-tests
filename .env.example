# Copy to .env and fill in. Every variable any notebook reads appears here.
# `.env` is gitignored - never commit real keys.

# ---------------------------------------------------------------------------
# Application under test
# ---------------------------------------------------------------------------

# Base URL of the running AML/KYC API. No trailing slash.
AML_API_BASE_URL=http://localhost:8000

# Sent as the `X-API-Key` header. Leave blank when the application runs with
# AUTH_MODE=off (the default). When AUTH_MODE=api_key, the key must resolve to
# a role that can reach every endpoint the notebooks use: `analyst` (cases,
# RAG, investigate), `eval_reader` (traces, eval export, MCP discovery) and
# `test_operator` (dev reset, MCP invoke). A single key cannot hold all three
# roles, so either run the app with AUTH_MODE=off or supply a key per role
# using the three variables below.
AML_API_KEY=

# Optional per-role keys. When set, they override AML_API_KEY for the calls
# that need that role. Leave blank if AML_API_KEY alone is sufficient.
AML_API_KEY_ANALYST=
AML_API_KEY_EVAL_READER=
AML_API_KEY_TEST_OPERATOR=

# Per-request timeout in seconds. An investigation run performs retrieval,
# several MCP tool calls and one LLM synthesis, so keep this generous.
AML_API_TIMEOUT_S=180

# The seed_version the goldens in these notebooks were authored against.
# A notebook fails loudly rather than scoring against different seed data.
AML_EXPECTED_SEED_VERSION=scenarios-v1

# When true, a notebook that needs first-run tool-planner behaviour calls
# POST /api/dev/reset first. This DROPS AND RECREATES EVERY TABLE in the
# application database. Leave false unless you intend that.
AML_RESET_BEFORE_RUN=false

# ---------------------------------------------------------------------------
# DeepEval judge model
# ---------------------------------------------------------------------------

# OpenAI key used by DeepEval's LLM judge. Required by every metric except
# ToolCorrectnessMetric, which is purely deterministic.
OPENAI_API_KEY=

# Judge model id. Must be a model id the installed DeepEval version knows and
# your OpenAI key can reach.
DEEPEVAL_JUDGE_MODEL=gpt-5.4-mini

# Keep DeepEval's anonymous telemetry off.
DEEPEVAL_TELEMETRY_OPT_OUT=YES

# ---------------------------------------------------------------------------
# Langfuse (only used by run_experiment.py, never by the 14 notebooks or
# run_all.py - see docs/observability-plan.md §3.1 and plan.md Phase 1).
# Requires `uv sync --extra langfuse`.
# ---------------------------------------------------------------------------

# From a Langfuse Cloud project in the EU region, synthetic-seed-data only
# per plan.md §0/§1.1 - do not point this at an instance holding anything
# but the known synthetic scenarios (AML_EXPECTED_SEED_VERSION above).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Host/region variable. Confirmed by inspecting the installed langfuse==4.14.1
# package directly (langfuse/_client/client.py): LANGFUSE_BASE_URL is checked
# first, LANGFUSE_HOST is the fallback, default is Cloud US if neither is
# set. Use the EU region host per plan.md §0/§1.1 - confirm the exact current
# EU hostname in Langfuse's own docs at provisioning time.
LANGFUSE_BASE_URL=

# The name one run of run_experiment.py is stored under. It is the key every
# later comparison groups by, and it lands in three places: the Langfuse
# `release` (the groupable `traceRelease` dashboard dimension), the run name
# shown in the UI ("aml-acceptance-summarization - <label>"), and the
# `run_label` in every score's metadata.
#
# LEAVE IT BLANK HERE. A label describes one run, not an environment, so it
# belongs on the command line:
#
#     AML_RUN_LABEL=before-planner-fix uv run python run_experiment.py
#
# Setting it in .env would stamp every future run with the same label, which
# silently merges runs that have nothing to do with each other.
#
# Unset, each run falls back to the UTC timestamp it started at, e.g.
# `20260731T155633Z`. That is enough to keep two runs apart, but it does not
# say what either one WAS - which is the whole point of labelling.
AML_RUN_LABEL=
