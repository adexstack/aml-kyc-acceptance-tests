# Copy to .env and fill in. Every variable any notebook reads appears here.
# `.env` is gitignored - never commit real keys.

# ---------------------------------------------------------------------------
# Application under test
# ---------------------------------------------------------------------------

# Base URL of the running AML/KYC API. No trailing slash.
AML_API_BASE_URL=http://localhost:8000

# Sent as the `X-API-Key` header. Leave blank when the application runs with
# AUTH_MODE=off (the default). When AUTH_MODE=api_key, the key must resolve to
# a role that can reach every endpoint the notebooks use: `analyst` (cases,
# RAG, investigate), `eval_reader` (traces, eval export, MCP discovery) and
# `test_operator` (dev reset, MCP invoke). A single key cannot hold all three
# roles, so either run the app with AUTH_MODE=off or supply a key per role
# using the three variables below.
AML_API_KEY=

# Optional per-role keys. When set, they override AML_API_KEY for the calls
# that need that role. Leave blank if AML_API_KEY alone is sufficient.
AML_API_KEY_ANALYST=
AML_API_KEY_EVAL_READER=
AML_API_KEY_TEST_OPERATOR=

# Per-request timeout in seconds. An investigation run performs retrieval,
# several MCP tool calls and one LLM synthesis, so keep this generous.
AML_API_TIMEOUT_S=180

# The seed_version the goldens in these notebooks were authored against.
# A notebook fails loudly rather than scoring against different seed data.
AML_EXPECTED_SEED_VERSION=scenarios-v1

# When true, a notebook that needs first-run tool-planner behaviour calls
# POST /api/dev/reset first. This DROPS AND RECREATES EVERY TABLE in the
# application database. Leave false unless you intend that.
AML_RESET_BEFORE_RUN=false

# ---------------------------------------------------------------------------
# DeepEval judge model
# ---------------------------------------------------------------------------

# OpenAI key used by DeepEval's LLM judge. Required by every metric except
# ToolCorrectnessMetric, which is purely deterministic.
OPENAI_API_KEY=

# Judge model id. Must be a model id the installed DeepEval version knows and
# your OpenAI key can reach.
DEEPEVAL_JUDGE_MODEL=gpt-5.4-mini

# Keep DeepEval's anonymous telemetry off.
DEEPEVAL_TELEMETRY_OPT_OUT=YES
